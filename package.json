{
  "name": "prospectai-monorepo",
  "version": "1.0.0",
  "main": "apps/mobile/node_modules/expo-router/entry",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "npm --prefix apps/mobile start",
    "mobile": "npm --prefix apps/mobile start",
    "web": "npm --prefix apps/web dev",
    "backend": "npm --prefix apps/backend dev",
    "api": "npm --prefix apps/backend dev",
    "android": "npm --prefix apps/mobile android",
    "ios": "npm --prefix apps/mobile ios",
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "build:backend": "npm --prefix apps/backend build",
    "typecheck": "turbo run typecheck",
    "typecheck:backend": "npm --prefix apps/backend typecheck",
    "lint": "turbo run lint",
    "start:mobile": "npm --prefix apps/mobile start",
    "start:web": "npm --prefix apps/web dev",
    "start:backend": "npm --prefix apps/backend dev",
    "start:api": "npm --prefix apps/backend dev"
  },
  "dependencies": {
    "@expo/ui": "~57.0.20",
    "@tanstack/react-query": "^5.104.0",
    "expo": "~57.0.25",
    "expo-constants": "~57.0.19",
    "expo-device": "~57.0.2",
    "expo-document-picker": "~57.0.2",
    "expo-font": "~57.0.4",
    "expo-glass-effect": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-linking": "~57.0.11",
    "expo-router": "~57.0.23",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "lucide-react-native": "^1.48.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "turbo": "^2.4.4",
    "typescript": "~6.0.3"
  }
}
