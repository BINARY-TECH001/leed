{
  "name": "prospectai-monorepo",
  "version": "1.0.0",
  "main": "apps/mobile/node_modules/expo-router/entry",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "npm --prefix apps/mobile start",
    "mobile": "npm --prefix apps/mobile start",
    "web": "npm --prefix apps/web dev",
    "backend": "npm --prefix apps/backend dev",
    "api": "npm --prefix apps/backend dev",
    "android": "npm --prefix apps/mobile android",
    "ios": "npm --prefix apps/mobile ios",
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "build:backend": "npm --prefix apps/backend build",
    "typecheck": "turbo run typecheck",
    "typecheck:backend": "npm --prefix apps/backend typecheck",
    "lint": "turbo run lint",
    "start:mobile": "npm --prefix apps/mobile start",
    "start:web": "npm --prefix apps/web dev",
    "start:backend": "npm --prefix apps/backend dev",
    "start:api": "npm --prefix apps/backend dev"
  },
  "dependencies": {
    "@expo/ui": "~58.0.27",
    "@tanstack/react-query": "^5.104.0",
    "expo": "^58.0.0",
    "expo-asset": "~58.0.20",
    "expo-constants": "~58.0.15",
    "expo-device": "~58.0.5",
    "expo-document-picker": "~58.0.4",
    "expo-font": "~58.0.11",
    "expo-glass-effect": "~58.0.5",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.18",
    "expo-linking": "~58.0.16",
    "expo-router": "~58.0.30",
    "expo-splash-screen": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.0.7",
    "lucide-react-native": "^1.48.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "turbo": "^2.4.4",
    "typescript": "~6.0.3"
  }
}
