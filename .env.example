# ==============================================================================
# LEED — ENVIRONMENT VARIABLES & PROVIDER CONFIGURATION TEMPLATE
# All secrets must be populated by the operator. Never commit actual secret values.
# ==============================================================================

# 1. Server & Runtime Environment
NODE_ENV="development"
PORT=4000
HOST="0.0.0.0"
CORS_ORIGIN="http://localhost:5173,http://localhost:8081"

# 2. Authentication Secrets (MUST be changed in production)
JWT_SECRET="replace_with_strong_random_jwt_secret_min_32_chars"
JWT_REFRESH_SECRET="replace_with_strong_random_refresh_secret_min_32_chars"

# 3. Database & Caching
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/prospectai?schema=public"
REDIS_URL="redis://localhost:6379"

# 4. Zero-Cost Interactive Channel: Telegram Bot API (100% Free)
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_from_botfather"
TELEGRAM_BOT_USERNAME="LeedOpportunityBot"
TELEGRAM_DRY_RUN=false

# 5. Free-Tier Transactional Email: Resend (3,000 emails/month free)
EMAIL_ENABLED=true
RESEND_API_KEY="re_placeholder_api_key"
EMAIL_FROM="Leed Opportunity Alerts <notifications@your-domain.com>"
EMAIL_DRY_RUN=false

# 6. Free Mobile & Web Push: Expo Push Service
PUSH_ENABLED=true
PUSH_DRY_RUN=false

# 7. Guardrailed Channel: Meta WhatsApp Cloud API (Disabled by default for $0 launch)
WHATSAPP_ENABLED=false
WHATSAPP_DRY_RUN=true
WHATSAPP_MONTHLY_BUDGET_USD=0.00
WHATSAPP_ESTIMATED_COST_PER_MSG_USD=0.035
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
WHATSAPP_VERIFY_TOKEN="your_custom_webhook_secret_verify_token"
META_APP_SECRET=""
WHATSAPP_MAX_DAILY_NOTIFICATIONS=5
WHATSAPP_DEFAULT_QUIET_HOURS_START="22:00"
WHATSAPP_DEFAULT_QUIET_HOURS_END="08:00"

# 8. Intelligence Provider: Google Gemini API (Free tier: 15 RPM / 1,500 RPD)
GEMINI_API_KEY="your_google_ai_studio_api_key"
AI_MODEL="gemini-2.0-flash"

# 9. Background Ingestion Workers
RADAR_WORKER_INTERVAL_MS=60000
FRESHNESS_WORKER_INTERVAL_MS=300000
